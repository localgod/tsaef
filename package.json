{
  "name": "tsaef",
  "version": "0.2.0",
  "description": "TypeScript library for the ArchiMate Exchange Format (AEF)",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "archimate",
    "aef",
    "exchange-format",
    "enterprise-architecture",
    "opengroup",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npx tsc",
    "dev": "npx tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --ignore-path .gitignore .",
    "lintfix": "oxlint --fix --ignore-path .gitignore .",
    "format": "oxfmt --check README.md LICENSE CHANGELOG.md src/**/*.mts tests/**/*.mts",
    "formatfix": "oxfmt README.md LICENSE CHANGELOG.md src/**/*.mts tests/**/*.mts"
  },
  "author": "Johannes Skov Frandsen",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/localgod/tsaef.git"
  },
  "homepage": "https://github.com/localgod/tsaef#readme",
  "bugs": {
    "url": "https://github.com/localgod/tsaef/issues"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.50.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
