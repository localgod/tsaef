{
  "name": "tsaef",
  "version": "0.3.0",
  "description": "TypeScript library for the ArchiMate Exchange Format (AEF)",
  "keywords": [
    "aef",
    "archimate",
    "enterprise-architecture",
    "exchange-format",
    "opengroup",
    "typescript"
  ],
  "homepage": "https://github.com/localgod/tsaef#readme",
  "bugs": {
    "url": "https://github.com/localgod/tsaef/issues"
  },
  "license": "ISC",
  "author": "Johannes Skov Frandsen",
  "repository": {
    "type": "git",
    "url": "https://github.com/localgod/tsaef.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint",
    "lintfix": "vp lint --fix",
    "format": "vp fmt --check",
    "formatfix": "vp fmt"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "xmllint-wasm": "^5.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
